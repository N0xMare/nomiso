# Local secrets. Copy to .env (gitignored) and fill in.
#   cp .env.example .env
# Load into the current shell:
#   set -a && source .env && set +a
#
# Chat key for Hindsight retain only (OpenAI-compatible chat/completions).
# Not embeddings. Not the plane foil (`just hindsight-up` stays LLM_PROVIDER=none).
# Same name as a typical OpenRouter .env: OPENROUTER_API_KEY=sk-or-…

OPENROUTER_API_KEY=

# scripts/hindsight.sh reads HINDSIGHT_API_LLM_API_KEY (else OPENAI_API_KEY).
HINDSIGHT_API_LLM_API_KEY="${OPENROUTER_API_KEY}"
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://openrouter.ai/api/v1
# Pin one model. Do not use openrouter/free or auto for a labeled row.
HINDSIGHT_API_LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Dedicated retain stack. Do not reuse hindsight-data / nomiso-hindsight (plane).
HINDSIGHT_CONTAINER=nomiso-hindsight-retain
HINDSIGHT_VOLUME=hindsight-retain-data
EVAL_HINDSIGHT_URL=http://127.0.0.1:8888
